# Server-only PostgreSQL connection string. `db:migrate` loads this file through dotenv; do not expose this value to browser code.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cambridgeyle
NODE_ENV=development
# Server-only Google OpenID Connect configuration. Use the Google issuer unless the
# approved provider changes; these values must never be prefixed NEXT_PUBLIC_.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Comma-separated, case-insensitive addresses that must receive admin access.
ADMIN_EMAILS=
# The AI draft provider gate remains open unless formally closed. Keys are server-only.
AI_DRAFT_PROVIDER_GATE_CLOSED=false
AI_TEXT_ENDPOINT=
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
AI_IMAGE_ENDPOINT=
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=
# Private object-store origin used only by the server to check and stream published media.
# Both values are required; practice preparation fails closed when either is absent.
MEDIA_BINARY_ORIGIN=
MEDIA_SIGNING_SECRET=
