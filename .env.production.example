# Production configuration for Docker Compose. Copy to .env.production (never commit it) and fill in every value.
NODE_ENV=production
# Database password; DATABASE_URL must use the same password and the "db" host.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://cambridgeyle:<POSTGRES_PASSWORD>@db:5432/cambridgeyle

# Google sign-in. Register the redirect URI in the Google OAuth client.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_REDIRECT_URI=https://cambridge.passionedu.org/api/auth/google/callback
# Comma-separated emails that receive admin access when they sign in with Google.
ADMIN_EMAILS=

# AI draft gateways (OpenAI-compatible API base URLs, e.g. https://host/v1). Set the gate to false to disable AI drafts.
AI_DRAFT_PROVIDER_GATE_CLOSED=false
AI_TEXT_ENDPOINT=
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
AI_IMAGE_ENDPOINT=
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=

# Private Cloudflare R2 bucket for media files.
R2_ACCESS_ENDPOINT=
R2_ACCESS_KEY=
R2_ACCESS_SECRET=
BUCKET=
# At least 32 characters, e.g. `openssl rand -base64 48`.
MEDIA_SIGNING_SECRET=
